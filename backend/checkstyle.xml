<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    FoodAI Platform - Checkstyle Configuration
    Based on Google Java Style Guide with customizations for Spring Boot
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- Exclude generated files -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value=".*[\\/]generated-sources[\\/].*"/>
    </module>

    <!-- Suppress checks for test classes where appropriate -->
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}" default=""/>
        <property name="optional" value="true"/>
    </module>

    <!-- File Length - max 2000 lines -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <!-- Line Length - max 120 characters -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a]* href|href|http://|https://|ftp://"/>
    </module>

    <!-- No Tab Characters -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Trailing Whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Line has trailing spaces."/>
    </module>

    <!-- Newline at End of File -->
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- ==================== Naming Conventions ==================== -->
        
        <!-- Package names should be lowercase -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
            <message key="name.invalidPattern"
                value="Package name ''{0}'' must match pattern ''{1}''."/>
        </module>

        <!-- Type names should be UpperCamelCase -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                value="Type name ''{0}'' must match pattern ''{1}''."/>
        </module>

        <!-- Method names should be lowerCamelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                value="Method name ''{0}'' must match pattern ''{1}''."/>
        </module>

        <!-- Parameter names should be lowerCamelCase -->
        <module name="ParameterName">
            <property name="format" value="^[a-z]([a-zA-Z0-9]*)?$"/>
            <message key="name.invalidPattern"
                value="Parameter name ''{0}'' must match pattern ''{1}''."/>
        </module>

        <!-- Local variable names should be lowerCamelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z]([a-zA-Z0-9]*)?$"/>
            <message key="name.invalidPattern"
                value="Local variable name ''{0}'' must match pattern ''{1}''."/>
        </module>

        <!-- Member variable names should be lowerCamelCase (no Hungarian notation) -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                value="Member name ''{0}'' must match pattern ''{1}''."/>
        </module>

        <!-- Constants should be UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$|^log$"/>
        </module>

        <!-- ==================== Imports ==================== -->
        
        <!-- No star imports -->
        <module name="AvoidStarImport"/>
        
        <!-- No unused imports -->
        <module name="UnusedImports"/>
        
        <!-- No redundant imports -->
        <module name="RedundantImport"/>
        
        <!-- Illegal imports (sun.*, internal.*) -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, com.sun"/>
        </module>
        
        <!-- Import order -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,jakarta,org,com"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="bottom"/>
        </module>

        <!-- ==================== Block Checks ==================== -->
        
        <!-- Empty blocks must have comment -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
        </module>
        
        <!-- Left curly brace placement -->
        <module name="LeftCurly"/>
        
        <!-- Right curly brace placement -->
        <module name="RightCurly">
            <property name="option" value="alone"/>
            <property name="tokens" value="CLASS_DEF, METHOD_DEF, CTOR_DEF, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT"/>
        </module>
        
        <!-- Need braces for all control structures -->
        <module name="NeedBraces"/>
        
        <!-- Nested blocks -->
        <module name="AvoidNestedBlocks"/>

        <!-- ==================== Coding Standards ==================== -->
        
        <!-- Empty statements (stray semicolons) -->
        <module name="EmptyStatement"/>
        
        <!-- Equals and hashCode must be overridden together -->
        <module name="EqualsHashCode"/>
        
        <!-- Hidden fields (local variable shadows instance variable) -->
        <module name="HiddenField">
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
            <property name="setterCanReturnItsClass" value="true"/>
        </module>
        
        <!-- Inner assignment (assignments in expressions) -->
        <module name="InnerAssignment"/>
        
        <!-- Magic numbers should be constants -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="severity" value="info"/>
        </module>
        
        <!-- Avoid inline conditionals (ternary operators in method calls) -->
        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL, CHAR_LITERAL"/>
            <property name="format"
                value="\\u00(09|0(a|A)|0(c|C)|0(d|D)|22|27|5(C|c))|\\(0(10|11|12|14|15|42|47)|134)"/>
            <property name="message"
                value="Consider using special escape sequence instead of octal value or Unicode escaped value."/>
        </module>
        
        <!-- One statement per line -->
        <module name="OneStatementPerLine"/>
        
        <!-- One declaration per line -->
        <module name="MultipleVariableDeclarations"/>
        
        <!-- Array style should be Java style: String[] args -->
        <module name="ArrayTypeStyle"/>
        
        <!-- Switch statements should have default clause -->
        <module name="MissingSwitchDefault"/>
        
        <!-- Fall through in switch must be commented -->
        <module name="FallThrough"/>
        
        <!-- Long constants should use L suffix -->
        <module name="UpperEll"/>
        
        <!-- Modifier order -->
        <module name="ModifierOrder"/>
        
        <!-- Redundant modifiers -->
        <module name="RedundantModifier"/>
        
        <!-- String equality -->
        <module name="StringLiteralEquality"/>
        
        <!-- Nested if depth -->
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        
        <!-- Nested try depth -->
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>
        
        <!-- Return count -->
        <module name="ReturnCount">
            <property name="max" value="5"/>
            <property name="maxForVoid" value="5"/>
        </module>
        
        <!-- Parameter number -->
        <module name="ParameterNumber">
            <property name="max" value="8"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        
        <!-- Cyclomatic complexity -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
            <property name="severity" value="warning"/>
        </module>
        
        <!-- Boolean expression complexity -->
        <module name="BooleanExpressionComplexity">
            <property name="max" value="5"/>
        </module>

        <!-- ==================== Javadoc ==================== -->
        
        <!-- Javadoc for public methods -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="minLineCount" value="2"/>
            <property name="allowedAnnotations" value="Override, Test, Bean, GetMapping, PostMapping, PutMapping, PatchMapping, DeleteMapping"/>
            <property name="severity" value="info"/>
        </module>
        
        <!-- Javadoc for public types -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="severity" value="info"/>
        </module>

        <!-- ==================== Whitespace ==================== -->
        
        <!-- Generic whitespace -->
        <module name="GenericWhitespace">
            <message key="ws.followed"
                value="GenericWhitespace ''{0}'' is followed by whitespace."/>
            <message key="ws.preceded"
                value="GenericWhitespace ''{0}'' is preceded with whitespace."/>
            <message key="ws.illegalFollow"
                value="GenericWhitespace ''{0}'' should followed by whitespace."/>
            <message key="ws.notPreceded"
                value="GenericWhitespace ''{0}'' is not preceded with whitespace."/>
        </module>
        
        <!-- Method parameter padding -->
        <module name="MethodParamPad"/>
        
        <!-- No whitespace after -->
        <module name="NoWhitespaceAfter">
            <property name="tokens" value="BNOT, DEC, DOT, INC, LNOT, UNARY_MINUS, UNARY_PLUS"/>
        </module>
        
        <!-- No whitespace before -->
        <module name="NoWhitespaceBefore"/>
        
        <!-- Operator wrap -->
        <module name="OperatorWrap">
            <property name="option" value="NL"/>
            <property name="tokens"
                value="BAND, BOR, BSR, BXOR, DIV, EQUAL, GE, GT, LAND, LE, LITERAL_INSTANCEOF, LOR,
                    LT, MINUS, MOD, NOT_EQUAL, PLUS, QUESTION, SL, SR, STAR"/>
        </module>
        
        <!-- Paren padding -->
        <module name="ParenPad"/>
        
        <!-- Separator wrap -->
        <module name="SeparatorWrap">
            <property name="option" value="nl"/>
            <property name="tokens" value="DOT"/>
        </module>
        
        <!-- Type cast paren padding -->
        <module name="TypecastParenPad"/>
        
        <!-- Whitespace around -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <message key="ws.notFollowed"
                value="WhitespaceAround: ''{0}'' is not followed by whitespace."/>
            <message key="ws.notPreceded"
                value="WhitespaceAround: ''{0}'' is not preceded with whitespace."/>
        </module>
        
        <!-- Empty line separator -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
        </module>

        <!-- ==================== Annotations ==================== -->
        
        <!-- Annotation location -->
        <module name="AnnotationLocation">
            <property name="allowSamelineMultipleAnnotations" value="false"/>
            <property name="allowSamelineSingleParameterlessAnnotation" value="true"/>
            <property name="allowSamelineParameterizedAnnotation" value="false"/>
        </module>

        <!-- ==================== Class Design ==================== -->
        
        <!-- One top level class per file -->
        <module name="OneTopLevelClass"/>
        
        <!-- Final class -->
        <module name="FinalClass"/>
        
        <!-- No public constructors for utility classes -->
        <module name="HideUtilityClassConstructor"/>
        
        <!-- Interface is type (no constant-only interfaces) -->
        <module name="InterfaceIsType"/>
        
        <!-- Visibility modifier -->
        <module name="VisibilityModifier">
            <property name="allowPublicFinalFields" value="true"/>
            <property name="protectedAllowed" value="true"/>
        </module>

        <!-- ==================== Miscellaneous ==================== -->
        
        <!-- Comment indentation -->
        <module name="CommentsIndentation"/>
        
        <!-- Indentation -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="8"/>
            <property name="lineWrappingIndentation" value="8"/>
            <property name="arrayInitIndent" value="4"/>
        </module>
        
        <!-- Outer type filename -->
        <module name="OuterTypeFilename"/>
        
        <!-- TODO comments should have format -->
        <module name="TodoComment">
            <property name="format" value="(TODO|FIXME|HACK|XXX)"/>
            <property name="severity" value="info"/>
        </module>

        <!-- Suppress warnings annotation -->
        <module name="SuppressWarningsHolder"/>
    </module>

    <!-- SuppressWarnings support -->
    <module name="SuppressWarningsFilter"/>
</module>

