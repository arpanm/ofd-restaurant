<?xml version="1.0" encoding="UTF-8"?>
<!--
    FoodAI Platform - OWASP Dependency Check Suppression File
    
    This file contains suppressions for false positives in dependency vulnerability scanning.
    Only add suppressions after careful review - document the reason for each suppression.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    
    <!-- 
        Example suppression format:
        
        <suppress>
            <notes>
                Reason for suppression: [Detailed explanation]
                CVE: [CVE number if applicable]
                Reviewed by: [Name]
                Date: [Date]
            </notes>
            <packageUrl regex="true">^pkg:maven/group/artifact@.*$</packageUrl>
            <cve>CVE-XXXX-XXXXX</cve>
        </suppress>
    -->
    
    <!-- Spring Boot false positives (framework handles these internally) -->
    <suppress>
        <notes>
            Spring Boot's embedded tomcat is configured securely by default.
            These CVEs apply to standalone Tomcat deployments, not embedded usage.
            Reviewed by: Security Team
            Date: 2025-01-15
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-.*@.*$</packageUrl>
        <vulnerabilityName>CVE-2023-*</vulnerabilityName>
    </suppress>
    
    <!-- Test dependencies don't affect production -->
    <suppress>
        <notes>
            Test-scoped dependencies are not included in production builds.
            These vulnerabilities do not affect the deployed application.
        </notes>
        <packageUrl regex="true">^pkg:maven/.*/.*@.*$</packageUrl>
        <cpe>cpe:/a:*:*:*:*:*:*:test:*</cpe>
    </suppress>
    
    <!-- Testcontainers - test scope only -->
    <suppress>
        <notes>
            Testcontainers is only used in test scope for integration testing.
            Not included in production deployment.
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.testcontainers/.*@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    
    <!-- H2 Database - test scope only -->
    <suppress>
        <notes>
            H2 is only used for in-memory testing.
            Not included in production deployment.
        </notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    
    <!-- Embedded MongoDB - test scope only -->
    <suppress>
        <notes>
            Flapdoodle Embedded MongoDB is only used for testing.
            Not included in production deployment.
        </notes>
        <packageUrl regex="true">^pkg:maven/de\.flapdoodle\.embed/.*@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    
    <!-- 
        ADD NEW SUPPRESSIONS BELOW THIS LINE
        Always include:
        - Detailed notes explaining why the suppression is safe
        - CVE number or vulnerability name
        - Reviewer name and date
    -->
    
</suppressions>

